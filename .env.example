# ==============================================================================
# REX Health Bot - Environment Configuration Template
# ==============================================================================
# Copy this file to .env and fill in the values.
# NEVER commit the actual .env file to version control.

# --- Telegram Bot Configuration ---
# Get your token from @BotFather
BOT_TOKEN=your_telegram_bot_token_here
# Comma-separated list of Telegram User IDs (e.g., 12345678,87654321)
ADMIN_IDS=1975808643

# --- LLM & AI Services ---
# OpenAI API Key for GPT models
OPENAI_API_KEY=sk-proj-your_openai_key_here
# Optional: Qwen API Key (if used)
QWEN_API_KEY=

# --- Google Services Integration ---
# Path to your Google Service Account JSON key file
GOOGLE_CREDENTIALS_FILE=google_key.json
# The ID of the Google Sheet (found in the URL of the sheet)
GOOGLE_SHEET_ID=your_google_sheet_id_here

# --- Database (PostgreSQL) ---
# Values used by the database container and the app
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_secure_db_password
POSTGRES_DB=rex_db
# Connection URL format: postgresql+asyncpg://user:password@host:port/dbname
# Use 'pgbouncer' or 'postgres_db' as host when running in Docker
DB_URL=postgresql+asyncpg://postgres:your_secure_db_password@pgbouncer:5432/rex_db

# --- Redis (FSM & Cache) ---
# Password for Redis authentication
REDIS_PASSWORD=your_redis_password
# Connection URL format: redis://:password@host:port/db_index
REDIS_URL=redis://:your_redis_password@redis:6379/0

# --- RabbitMQ (Message Broker) ---
# Connection URL format: amqp://user:password@host:port/
RABBIT_URL=amqp://guest:guest@rabbitmq:5672/

# --- Proxy Settings (Squid) ---
# Used for outgoing requests to OpenAI/Telegram if needed
SQUID_PROXY_HOST=
SQUID_PROXY_PORT=
SQUID_PROXY_USER=
SQUID_PROXY_PASSWORD=

# --- Observability & Monitoring ---
# Admin password for Grafana dashboard
GRAFANA_PASSWORD=admin_password_here
